    @brief View of an Issue which displays a summary for use in lists

    @uses $issue Issue The issue
--}}
@php
    $issueTitle = $issue->getShowTitle() ? $issue->getLocalizedTitle() : null;
    $issueSeries = $issue->getIssueSeries();
    $issueCover = $issue->getLocalizedCoverImageUrl();
@endphp

<div class="obj_issue_summary">

    @if($issueCover)
        <a class="cover" href="@url(['op' => 'view', 'path' => $issue->getBestIssueId()])">
            <img src="{{ $issueCover }}" alt="{{ $issue->getLocalizedCoverImageAltText() ?? '' }}">
        </a>
    @endif

    <h2>
        <a class="title" href="@url(['op' => 'view', 'path' => $issue->getBestIssueId()])">
            @if($issueTitle)
                {{ $issueTitle }}
            @else
                {{ $issueSeries }}
            @endif
        </a>
        @if($issueTitle && $issueSeries)
            <div class="series">
                {{ $issueSeries }}
            </div>
        @endif
    </h2>

    <div class="description">
        {!! Str::sanitizeHtml($issue->getLocalizedDescription()) !!}
    </div>
</div>{{-- .obj_issue_summary --}}
