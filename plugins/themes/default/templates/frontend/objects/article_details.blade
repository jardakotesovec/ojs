                            @else
                                <span>{{ __('submission.updatedOn', [
                                    'datePublished' => Str::bladeDateFormat($firstPublication->getData('datePublished'), $dateFormatShort),
                                    'dateUpdated' => Str::bladeDateFormat($publication->getData('datePublished'), $dateFormatShort)
                                ]) }}</span>
