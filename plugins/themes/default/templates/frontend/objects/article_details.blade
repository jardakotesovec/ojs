                            <li>
                                @include('frontend.objects.galley_link', [
                                    'parent' => $article,
                                    'publication' => $publication,
                                    'galley' => $galley,
                                    'isSupplementary' => true
                                ])
                            </li>
                        @endforeach
                    </ul>
                </div>
            @endif

            @if($publication->getData('datePublished'))
                <div class="item published">
                    <section class="sub_item">
                        <h2 class="label">
                            {{ __('submissions.published') }}
                        </h2>
                        <div class="value">
