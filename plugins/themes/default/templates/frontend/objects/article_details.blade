                    @endif

                    @if($section ?? null)
                        <section class="sub_item">
                            <h2 class="label">
                                {{ __('section.section') }}
                            </h2>
                            <div class="value">
                                {{ $section->getLocalizedTitle() }}
                            </div>
                        </section>
                    @endif

                    @if($categories ?? null)
                        <section class="sub_item">
                            <h2 class="label">
                                {{ __('category.category') }}
                            </h2>
                            <div class="value">
                                <ul class="categories">
                                    @foreach($categories as $category)
                                        <li><a href="@url(['router' => \PKP\core\PKPApplication::ROUTE_PAGE, 'page' => 'catalog', 'op' => 'category', 'path' => $category->getPath()])">{{ $category->getLocalizedTitle() }}</a></li>
                                    @endforeach
                                </ul>
                            </div>
                        </section>
                    @endif
                </div>
            @endif

            @if($enablePublicComments ?? false)
                <div class="item comments">
                    <section class="sub_item" data-vue-root>
                        <h2 class="label"> {{ __('userComment.comments') }} </h2>
                        <pkp-scroll-to-comments></pkp-scroll-to-comments>
                    </section>
                </div>
            @endif

            {{-- AddThis sharing widget --}}
            {{-- PubIds (requires plugins) --}}
            @foreach(($pubIdPlugins ?? []) as $pubIdPlugin)
                @if($pubIdPlugin->getPubIdType() == 'doi')
                    @continue
                @endif
                @php $pubId = $publication->getStoredPubId($pubIdPlugin->getPubIdType()); @endphp
                @if($pubId)
                    <section class="item pubid">
                        <h2 class="label">
                            {{ $pubIdPlugin->getPubIdDisplayType() }}
                        </h2>
                        <div class="value">
                            @if($pubIdPlugin->getResolvingURL($currentJournal->getId(), $pubId))
                                <a id="pub-id::{{ $pubIdPlugin->getPubIdType() }}" href="{{ $pubIdPlugin->getResolvingURL($currentJournal->getId(), $pubId) }}">
                                    {{ $pubIdPlugin->getResolvingURL($currentJournal->getId(), $pubId) }}
                                </a>
                            @else
                                {{ $pubId }}
                            @endif
                        </div>
                    </section>
                @endif
            @endforeach

            {{-- Licensing info --}}
            @if($currentContext->getLocalizedData('licenseTerms') || $publication->getData('licenseUrl'))
                <div class="item copyright">
                    <h2 class="label">
                        {{ __('submission.license') }}
                    </h2>
                    @if($publication->getData('licenseUrl'))
                        @if($ccLicenseBadge ?? null)
                            @if($publication->getLocalizedData('copyrightHolder'))
                                <p>{{ __('submission.copyrightStatement', [
                                    'copyrightHolder' => $publication->getLocalizedData('copyrightHolder'),
                                    'copyrightYear' => $publication->getData('copyrightYear')
                                ]) }}</p>
                            @endif
                            {!! $ccLicenseBadge !!}
                        @else
                            <a href="{{ $publication->getData('licenseUrl') }}" class="copyright">
                                @if($publication->getLocalizedData('copyrightHolder'))
                                    {{ __('submission.copyrightStatement', [
                                        'copyrightHolder' => $publication->getLocalizedData('copyrightHolder'),
                                        'copyrightYear' => $publication->getData('copyrightYear')
                                    ]) }}
                                @else
                                    {{ __('submission.license') }}
                                @endif
                            </a>
                        @endif
                    @endif
                    {!! $currentContext->getLocalizedData('licenseTerms') !!}
                </div>
            @endif

            @callHook(['name' => 'Templates::Article::Details'])

        </div>{{-- .entry_details --}}
    </div>{{-- .row --}}

</article>
