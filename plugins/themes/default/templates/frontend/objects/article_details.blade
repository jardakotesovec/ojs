                    </section>
                    <section class="sub_item versions">
                        <h2 class="label">
                            {{ __('submission.versions') }}
                        </h2>
                        <ul class="value">
                            @foreach(array_reverse($article->getPublishedPublications()) as $iPublication)
                                @php
                                    $name = __('submission.versionIdentity', [
                                        'datePublished' => Str::bladeDateFormat($iPublication->getData('datePublished'), $dateFormatShort),
                                        'version' => $iPublication->getData('versionString')
                                    ]);
                                @endphp
                                <li>
                                    @if($iPublication->getId() === $publication->getId())
                                        {{ $name }}
                                    @elseif($iPublication->getId() === $currentPublication->getId())
                                        <a href="@url(['page' => 'article', 'op' => 'view', 'path' => [$article->getBestId()]])">{{ $name }}</a>
                                    @else
                                        <a href="@url(['page' => 'article', 'op' => 'view', 'path' => array_merge([$article->getBestId()], ['version', $iPublication->getId()])])">{{ $name }}</a>
                                    @endif
                                </li>
                            @endforeach
                        </ul>
                    </section>
                </div>
            @endif

            {{-- Data Availability Statement --}}
            @if($publication->getLocalizedData('dataAvailability'))
                <section class="item dataAvailability" id="data-availability-statement">
                    <h2 class="label">{{ __('submission.dataAvailability') }}</h2>
                    {!! Str::sanitizeHtml($publication->getLocalizedData('dataAvailability')) !!}
                </section>
            @endif

            {{-- Issue article appears in --}}
            @if(($issue ?? null) || ($section ?? null) || ($categories ?? null))
                <div class="item issue">

                    @if($issue ?? null)
                        <section class="sub_item">
                            <h2 class="label">
                                {{ __('issue.issue') }}
                            </h2>
                            <div class="value">
                                <a class="title" href="@url(['page' => 'issue', 'op' => 'view', 'path' => $issue->getBestIssueId()])">
                                    {{ $issue->getIssueIdentification() }}
