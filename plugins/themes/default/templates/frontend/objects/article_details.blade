                            </li>
                        @endforeach
                    </ul>
                </div>
            @endif
            @if($supplementaryGalleys ?? null)
                <div class="item galleys">
                    <h3 class="pkp_screen_reader">
                        {{ __('submission.additionalFiles') }}
                    </h3>
                    <ul class="value supplementary_galleys_links">
