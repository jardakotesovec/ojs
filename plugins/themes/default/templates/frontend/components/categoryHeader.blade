<section class="categoryHeader">
    <section class="categoryHeader_categories">
        <ul class="categories_listing">
            @foreach($categories ?? [] as $category)
                @if(!$category->getParentId())
                    <li class="category_{{ $category->getPath() }}">
                        <a href="@url(['router' => \PKP\core\PKPApplication::ROUTE_PAGE, 'page' => 'catalog', 'op' => 'category', 'path' => $category->getPath()])">
                            {{ $category->getLocalizedTitle() }}
                        </a>
                    </li>
                @endif
            @endforeach
        </ul>
    </section>
</section>
