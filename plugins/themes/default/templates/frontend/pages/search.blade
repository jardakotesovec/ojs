    @brief Display the page to search and view search results.

    @uses $query Value of the primary search query
    @uses $dateFrom Value of the date from search filter (published after).
     Value is a single string: YYYY-MM-DD HH:MM:SS
    @uses $dateTo Value of the date to search filter (published before).
     Value is a single string: YYYY-MM-DD HH:MM:SS
    @uses $yearStart Earliest year that can be used in from/to filters
    @uses $yearEnd Latest year that can be used in from/to filters

    @hook Templates::Search::SearchResults::AdditionalFilters []
    @hook Templates::Search::SearchResults::PreResults []
--}}
@include('frontend.components.header', ['pageTitle' => 'common.search'])

@php
    $heading = $heading ?? 'h2';
@endphp

<div class="page page_search">

    @include('frontend.components.breadcrumbs', ['currentTitleKey' => 'common.search'])
    <h1>
        {{ __('common.search') }}
    </h1>

    @php
        // Get current URL and parse parameters
        $searchFormUrl = ViewHelper::url([]);
        $formUrlParameters = [];
        $queryString = parse_url($searchFormUrl, PHP_URL_QUERY);
        if ($queryString) {
            parse_str($queryString, $formUrlParameters);
        }
        $baseUrl = strtok($searchFormUrl, '?');
    @endphp
    <form class="cmp_form" method="get" action="{{ $baseUrl }}" role="form">
        @foreach($formUrlParameters as $paramKey => $paramValue)
            <input type="hidden" name="{{ $paramKey }}" value="{{ $paramValue }}"/>
        @endforeach

        {{-- Repeat the label text just so that screen readers have a clear
           label/input relationship --}}
        <div class="search_input">
            <label class="pkp_screen_reader" for="query">
                {{ __('search.searchFor') }}
            </label>
            @section('searchQuery')
                <input type="text" id="query" name="query" value="{{ $query ?? '' }}" class="query" placeholder="{{ __('common.search') }}">
            @show
        </div>

        <fieldset class="search_advanced">
            <legend>
                {{ __('search.advancedFilters') }}
            </legend>
            <div class="date_range">
                <div class="from">
                    @php
                        $dateFromLegend = __('search.dateFrom');
                    @endphp
                    @htmlSelectDateA11y(['legend' => $dateFromLegend, 'prefix' => 'dateFrom', 'time' => $dateFrom ?? '', 'start_year' => $yearStart ?? '', 'end_year' => $yearEnd ?? ''])
                </div>
                <div class="to">
                    @php
                        $dateFromTo = __('search.dateTo');
                    @endphp
                    @htmlSelectDateA11y(['legend' => $dateFromTo, 'prefix' => 'dateTo', 'time' => $dateTo ?? '', 'start_year' => $yearStart ?? '', 'end_year' => $yearEnd ?? ''])
                </div>
            </div>
            <div class="additional_options">
                @if($searchableContexts ?? null)
                    <label class="label label_contexts" for="searchContext">
                        {{ __('search.journal') }}
                    </label>
                    <select name="searchContext" id="searchContext">
                        <option></option>
                        @foreach($searchableContexts as $searchableContext)
                            <option value="{{ $searchableContext->id }}" {{ ($searchContext ?? null) == $searchableContext->id ? 'selected' : '' }}>
                                {{ $searchableContext->name }}
                            </option>
                        @endforeach
                    </select>
                @endif
            </div>
            @callHook(['name' => 'Templates::Search::SearchResults::AdditionalFilters'])
        </fieldset>

        <div class="submit">
            <button class="submit" type="submit">{{ __('common.search') }}</button>
        </div>
    </form>

    @callHook(['name' => 'Templates::Search::SearchResults::PreResults'])

    <h2 class="pkp_screen_reader">{{ __('search.searchResults') }}</h2>

    {{-- Results pagination --}}
    @php
        $count = ($results ?? null) ? $results->count() : 0;
    @endphp
    @if($count)
        <div class="pkp_screen_reader" role="status">
            @if($count > 1)
                {{ __('search.searchResults.foundPlural', ['count' => $count]) }}
            @else
                {{ __('search.searchResults.foundSingle') }}
            @endif
        </div>
    @endif

    {{-- Search results, finally! --}}
    <ul class="search_results">
        @foreach($results ?? [] as $result)
            <li>
                @include('frontend.objects.article_summary', [
                    'article' => $result['submission'],
                    'journal' => $result['context'],
                    'showDatePublished' => true,
                    'hideGalleys' => true,
                    'heading' => 'h3'
                ])
            </li>
        @endforeach
    </ul>

    {{-- No results found --}}
    @if($count == 0)
        <span role="status">
            @include('frontend.components.notification', ['type' => 'notice', 'messageKey' => 'search.noResults'])
        </span>

    {{-- Results pagination --}}
    @else
        <div class="cmp_pagination">
            @pageInfo(['iterator' => $results])
            @pageLinks(['anchor' => 'results', 'iterator' => $results, 'name' => 'search', 'query' => $query ?? null, 'searchContext' => $searchContext ?? null, 'authors' => $authors ?? null, 'dateFromMonth' => $dateFromMonth ?? null, 'dateFromDay' => $dateFromDay ?? null, 'dateFromYear' => $dateFromYear ?? null, 'dateToMonth' => $dateToMonth ?? null, 'dateToDay' => $dateToDay ?? null, 'dateToYear' => $dateToYear ?? null])
        </div>
    @endif

    {{-- Search Syntax Instructions --}}
    @section('searchSyntaxInstructions')
    @show
</div>{{-- .page --}}

@include('frontend.components.footer')
