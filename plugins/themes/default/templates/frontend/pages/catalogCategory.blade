    @brief Display the page to view a category of the catalog.

    @uses $category Category Current category being viewed
    @uses $publishedSubmissions array List of published submissions in this category
    @uses $parentCategory Category Parent category if one exists
    @uses $subcategories array List of subcategories if they exist
    @uses $prevPage int The previous page number
    @uses $nextPage int The next page number
    @uses $showingStart int The number of the first item on this page
    @uses $showingEnd int The number of the last item on this page
    @uses $total int Count of all published submissions in this category
--}}
@include('frontend.components.header', ['pageTitleTranslated' => $category->getLocalizedTitle()])

<div class="page page_catalog_category">

    {{-- Breadcrumb --}}
    @include('frontend.components.breadcrumbs_catalog', [
        'type' => 'category',
        'parent' => $parentCategory ?? null,
        'currentTitle' => $category->getLocalizedTitle()
    ])
    <h1>
        {{ $category->getLocalizedTitle() }}
    </h1>

    {{-- Count of articles in this category --}}
    <div class="article_count">
        {{ __('catalog.browseTitles', ['numTitles' => $total]) }}
    </div>

    {{-- Image and description --}}
    @php
        $image = $category->getImage();
        $description = ViewHelper::sanitizeHtml($category->getLocalizedDescription());
    @endphp
    <div class="about_section{{ $image ? ' has_image' : '' }}{{ $description ? ' has_description' : '' }}">
        @if($image)
            <div class="cover" href="{{ ViewHelper::url(['router' => \PKP\core\PKPApplication::ROUTE_PAGE, 'page' => 'catalog', 'op' => 'fullSize', 'type' => 'category', 'id' => $category->getId()]) }}">
                <img src="{{ ViewHelper::url(['router' => \PKP\core\PKPApplication::ROUTE_PAGE, 'page' => 'catalog', 'op' => 'thumbnail', 'type' => 'category', 'id' => $category->getId()]) }}" alt="null" />
            </div>
        @endif
        <div class="description">
            {!! ViewHelper::sanitizeHtml($description) !!}
        </div>
    </div>

    @if(count($subcategories ?? []))
    <nav class="subcategories" role="navigation">
        <h2>
            {{ __('catalog.category.subcategories') }}
        </h2>
        <ul>
            @foreach($subcategories as $subcategory)
                <li>
                    <a href="{{ ViewHelper::url(['op' => 'category', 'path' => $subcategory->getPath()]) }}">
                        {{ $subcategory->getLocalizedTitle() }}
                    </a>
                </li>
            @endforeach
        </ul>
    </nav>
    @endif

    <h2 class="title">
        {{ __('catalog.category.heading') }}
    </h2>

    {{-- No published titles in this category --}}
    @if(empty($publishedSubmissions))
        <p>{{ __('catalog.category.noItems') }}</p>
    @else
        <ul class="cmp_article_list articles">
            @foreach($publishedSubmissions as $article)
                <li>
                    @include('frontend.objects.article_summary', [
                        'article' => $article,
                        'hideGalleys' => true,
                        'heading' => 'h3'
                    ])
                </li>
            @endforeach
        </ul>

        {{-- Pagination --}}
        @php
            $prevUrl = null;
            $nextUrl = null;
            if (($prevPage ?? null) > 1) {
                $prevUrl = ViewHelper::url([
                    'router' => \PKP\core\PKPApplication::ROUTE_PAGE,
                    'page' => 'catalog',
                    'op' => 'category',
                    'path' => array_merge((array)$category->getPath(), [$prevPage])
                ]);
            } elseif (($prevPage ?? null) === 1) {
                $prevUrl = ViewHelper::url([
                    'router' => \PKP\core\PKPApplication::ROUTE_PAGE,
                    'page' => 'catalog',
                    'op' => 'category',
                    'path' => $category->getPath()
                ]);
            }
            if ($nextPage ?? null) {
                $nextUrl = ViewHelper::url([
                    'router' => \PKP\core\PKPApplication::ROUTE_PAGE,
                    'page' => 'catalog',
                    'op' => 'category',
                    'path' => array_merge((array)$category->getPath(), [$nextPage])
                ]);
            }
        @endphp
        @include('frontend.components.pagination', [
            'prevUrl' => $prevUrl,
            'nextUrl' => $nextUrl,
            'showingStart' => $showingStart ?? null,
            'showingEnd' => $showingEnd ?? null,
            'total' => $total
        ])
    @endif

</div>{{-- .page --}}

@include('frontend.components.footer')
