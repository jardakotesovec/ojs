    @brief Display the index page for a journal

    @uses $currentJournal Journal This journal
    @uses $journalDescription string Journal description from HTML text editor
    @uses $homepageImage object Image to be displayed on the homepage
    @uses $additionalHomeContent string Arbitrary input from HTML text editor
    @uses $announcements array List of announcements
    @uses $numAnnouncementsHomepage int Number of announcements to display on the
          homepage
    @uses $issue Issue Current issue

    @hook Templates::Index::journal []
--}}
@include('frontend.components.header', ['pageTitleTranslated' => $currentJournal->getLocalizedName()])

<div class="page_index_journal">

    @callHook(['name' => 'Templates::Index::journal'])

    @if(($highlights ?? null) && $highlights->count())
        @include('frontend.components.highlights', ['highlights' => $highlights])
    @endif

    @if(($activeTheme ?? null) && !$activeTheme->getOption('useHomepageImageAsHeader') && ($homepageImage ?? null))
        <div class="homepage_image">
            <img src="{{ $publicFilesDir }}/{{ rawurlencode($homepageImage['uploadName']) }}"{{ isset($homepageImage['altText']) ? ' alt="' . $homepageImage['altText'] . '"' : '' }}>
        </div>
    @endif

    @if(($categories ?? null) && $categories->count() > 0)
        @include('frontend.components.categoryHeader', ['categories' => $categories])
    @endif

    {{-- Journal Description --}}
    @if(($activeTheme ?? null) && $activeTheme->getOption('showDescriptionInJournalIndex'))
        <section class="homepage_about">
            <a id="homepageAbout"></a>
            <h2>{{ __('about.aboutContext') }}</h2>
            {!! $currentContext->getLocalizedData('description') !!}
        </section>
    @endif

    @include('frontend.objects.announcements_list', ['numAnnouncements' => $numAnnouncementsHomepage ?? null])

    {{-- Latest Published Publications --}}
    @if(($publishedPublications ?? null) && $publishedPublications->count())
        @include('frontend.objects.latest_article', ['articles' => $publishedPublications, 'heading' => 'h2'])
    @endif

    {{-- Latest issue --}}
    @if($issue ?? null)
        <section class="current_issue">
            <a id="homepageIssue"></a>
            <h2>
                {{ __('journal.currentIssue') }}
            </h2>
            <div class="current_issue_title">
                {{ $issue->getIssueIdentification() }}
            </div>
            @include('frontend.objects.issue_toc', ['heading' => 'h3'])
            <a href="{{ ViewHelper::url(['router' => \PKP\core\PKPApplication::ROUTE_PAGE, 'page' => 'issue', 'op' => 'archive']) }}" class="read_more">
                {{ __('journal.viewAllIssues') }}
            </a>
        </section>
    @endif

    {{-- Additional Homepage Content --}}
    @if($additionalHomeContent ?? null)
        <div class="additional_content">
            {!! $additionalHomeContent !!}
        </div>
    @endif
</div>{{-- .page --}}

@include('frontend.components.footer')
