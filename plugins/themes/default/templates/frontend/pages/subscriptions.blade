                        </td>
                        <td>{{ __($subscriptionType->getFormatString()) }}</td>
                        <td>{{ $subscriptionType->getDurationYearsMonths() }}</td>
                        <td>{{ sprintf('%.2f', $subscriptionType->getCost()) }}&nbsp;({{ $subscriptionType->getCurrencyStringShort() }})</td>
                    </tr>
                @endforeach
            </table>
        </div>
        @if($isUserLoggedIn ?? false)
            <div class="subscriptions_individual_purchase">
                <a class="action" href="@url(['page' => 'user', 'op' => 'purchaseSubscription', 'path' => 'individual'])">
