    <a name="subscriptionTypes"></a>
    @if(count($individualSubscriptionTypes ?? []))
        <div class="subscriptions_institutional">
            <h3>{{ __('about.subscriptions.individual') }}</h3>
            <p>{{ __('subscriptions.individualDescription') }}</p>
